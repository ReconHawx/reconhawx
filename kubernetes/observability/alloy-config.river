// Grafana Alloy: ship Kubernetes pod logs to Loki (in-cluster).
// Only the reconhawx namespace (app workloads + runner/worker Jobs). Observability stack logs stay in-cluster only.
//
// discovery.relabel must copy __meta_kubernetes_* onto plain labels (namespace, pod, app, …) so Loki
// exposes them in /loki/api/v1/labels and LogQL like {namespace="reconhawx"} works.
// Init containers are dropped (avoids noisy reconnect loops on short-lived inits like grafana init-chown-data).

logging {
  level  = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "filtered" {
  targets = discovery.kubernetes.pods.targets

  // Drop init containers (they exit quickly; tailing them spams reconnect logs).
  rule {
    source_labels = ["__meta_kubernetes_pod_container_init"]
    regex         = "true"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "reconhawx"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "(.+)"
    target_label  = "namespace"
    action        = "replace"
    replacement   = "${1}"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    regex         = "(.+)"
    target_label  = "pod"
    action        = "replace"
    replacement   = "${1}"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    regex         = "(.+)"
    target_label  = "container"
    action        = "replace"
    replacement   = "${1}"
  }

  // Reconhawx workflow runner/worker Jobs label workflow-id (execution id). K8s hyphens →
  // __meta_kubernetes_pod_label_workflow_id (Prometheus SD). Loki label names cannot contain "-".
  rule {
    source_labels = ["__meta_kubernetes_pod_label_workflow_id"]
    regex         = "(.+)"
    target_label  = "workflow_id"
    action        = "replace"
    replacement   = "${1}"
  }

  // Runner pods also label execution-id (same value as workflow-id for runs).
  rule {
    source_labels = ["__meta_kubernetes_pod_label_execution_id"]
    regex         = "(.+)"
    target_label  = "execution_id"
    action        = "replace"
    replacement   = "${1}"
  }

  // Worker pods: Kubernetes label task-name → Loki task_name (hyphens not allowed in Loki label names).
  rule {
    source_labels = ["__meta_kubernetes_pod_label_task_name"]
    regex         = "(.+)"
    target_label  = "task_name"
    action        = "replace"
    replacement   = "${1}"
  }

  // Worker pods: Kubernetes label workflow-name → Loki workflow_name.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_workflow_name"]
    regex         = "(.+)"
    target_label  = "workflow_name"
    action        = "replace"
    replacement   = "${1}"
  }

  // app.kubernetes.io/name (Helm charts) first…
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "(.+)"
    target_label  = "app"
    action        = "replace"
    replacement   = "${1}"
  }

  // …then plain `app=` overwrites when both exist (matches Reconhawx Deployments).
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "(.+)"
    target_label  = "app"
    action        = "replace"
    replacement   = "${1}"
  }
}

loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.filtered.output
  forward_to = [loki.process.parse_recon_json.receiver]
}

// Reconhawx app images emit one JSON object per line (LOG_FORMAT=json, see recon_log_format.py):
// timestamp, level, logger, message, service, type (application | http_access). Worker uses the same
// schema to stderr. Frontend nginx (kubernetes/base/frontend/nginx-config.yaml) matches these fields.
// Parse for Loki: real event time, level label, structured metadata; stored log line = raw JSON.
loki.process "parse_recon_json" {
  forward_to = [loki.write.default.receiver]

  stage.match {
    selector = "{namespace=\"reconhawx\"}"

    stage.json {
      expressions = {
        ts     = "timestamp",
        level  = "level",
        logger = "logger",
        type   = "type",
        method = "method",
        status = "status",
      }
    }

    // RFC3339Nano matches e.g. "2026-04-24T19:20:13.038Z".
    stage.timestamp {
      source            = "ts"
      format            = "RFC3339Nano"
      action_on_failure = "skip"
    }

    // Low-cardinality label for LogQL and Grafana log-level coloring.
    stage.labels {
      values = { level = "level" }
    }

    // method/status omitted on application logs (missing JSON keys). Use app label, not service metadata.
    stage.structured_metadata {
      values = {
        logger = "logger",
        type   = "type",
        method = "method",
        status = "status",
      }
    }
  }
}

loki.write "default" {
  endpoint {
    url       = "http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push"
    tenant_id = "fake"
  }
}
